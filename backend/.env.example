NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=postgres
DB_SSL=false
DB_POOL_MAX=10

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10
OTP_DEV_RESPONSE=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=SmartPlacify
BREVO_SMS_SENDER=SMARTPLC
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smartplacify/profiles
BCRYPT_ROUNDS=12

UPLOAD_DIR=uploads/resumes
MAX_UPLOAD_MB=5
